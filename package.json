{
  "name": "bot-minicraft-dudu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bot companheiro para Minecraft Java Edition com IA local ou de nuvem",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/app/main.ts",
    "dev:once": "tsx src/app/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/app/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "dotenv": "^16.4.7",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "ollama": "^0.5.11",
    "pino": "^9.6.0",
    "vec3": "^0.1.10",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
