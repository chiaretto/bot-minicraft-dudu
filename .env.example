# Segredos do bot. Copie para `.env` e preencha.
# NUNCA coloque nenhum destes valores em config.yaml — o loader recusa iniciar.

# Senha/token da conta Minecraft do bot.
# Só é necessária em servidor com autenticação online.
MINECRAFT_PASSWORD=

# Chave da API do Google Gemini.
# EXIGIDA APENAS se llm.provider (ou llm.fallbackProvider) for "gemini".
# Com o provider padrão "ollama" o bot sobe sem nenhum segredo.
GEMINI_API_KEY=
